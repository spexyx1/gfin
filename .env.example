# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Smart Contract Configuration
VITE_ESCROW_CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
VITE_USDC_CONTRACT_ADDRESS=0xA0b86a33E6417c4c4c4c4c4c4c4c4c4c4c4c4c4c
VITE_GHETTO_TOKEN_ADDRESS=0xB0b86a33E6417c4c4c4c4c4c4c4c4c4c4c4c4c4c

# Network Configuration
# Options: 'mainnet' (Polygon) or 'testnet' (Mumbai)
VITE_NETWORK_ENV=mainnet

# Polygon RPC URLs (optional, uses public RPCs by default)
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Hardhat Deployment Configuration
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Polygon USDC Token Addresses
# Mainnet: 0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
# Mumbai Testnet: 0x0FA8781a83E46826621b3BC094Ea2A0212e71B23
